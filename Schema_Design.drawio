        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n  DEPARTMENTS {\n    int department_id PK\n    varchar name UK\n    varchar building\n    timestamp created_at\n  }\n\n  USERS {\n    int user_id PK\n    varchar email UK\n    varchar password_hash\n    varchar full_name\n    smallint tier_level\n    int department_id FK\n    timestamp created_at\n  }\n\n  EQUIPMENT_ASSETS {\n    int asset_id PK\n    varchar asset_tag UK\n    varchar name\n    varchar status\n    int department_id FK\n    timestamp created_at\n  }\n\n  SERVICE_TICKETS {\n    int ticket_id PK\n    varchar title\n    text description\n    varchar priority\n    varchar status\n    int requester_id FK\n    int assigned_agent_id FK\n    timestamp created_at\n  }\n\n  KNOWLEDGE_ARTICLES {\n    int article_id PK\n    varchar title\n    text content\n    int author_id FK\n    timestamp published_at\n  }\n\n  ROOM_BOOKINGS {\n    int booking_id PK\n    varchar room_name\n    int booked_by_user_id FK\n    timestamp start_time\n    timestamp end_time\n    varchar status\n  }\n\n  MAINTENANCE_LOGS {\n    int log_id PK\n    int asset_id FK\n    int performed_by_user_id FK\n    text log_details\n    timestamp logged_at\n  }\n\n  AUDIT_LOGS {\n    int audit_id PK\n    int actor_user_id FK\n    varchar action_type\n    varchar target_entity\n    timestamp timestamp\n  }\n\n  TICKET_ASSET_ALLOCATIONS {\n    int ticket_id PK, FK\n    int asset_id PK, FK\n    timestamp allocated_at\n    varchar allocation_status\n    varchar condition_on_issue\n  }\n\n  TICKET_COLLABORATORS {\n    int ticket_id PK, FK\n    int agent_id PK, FK\n    varchar assigned_role\n    timestamp joined_at\n    boolean is_lead\n  }\n\n  DEPARTMENTS ||--o{ USERS : \&quot;employs RESTRICT\&quot;\n  DEPARTMENTS ||--o{ EQUIPMENT_ASSETS : \&quot;owns RESTRICT\&quot;\n  USERS ||--o{ SERVICE_TICKETS : \&quot;requests RESTRICT\&quot;\n  USERS ||--o{ SERVICE_TICKETS : \&quot;assigned as agent SET NULL\&quot;\n  USERS ||--o{ KNOWLEDGE_ARTICLES : \&quot;authors SET NULL\&quot;\n  USERS ||--o{ ROOM_BOOKINGS : \&quot;books CASCADE\&quot;\n  USERS ||--o{ MAINTENANCE_LOGS : \&quot;performs SET NULL\&quot;\n  USERS ||--o{ AUDIT_LOGS : \&quot;acts SET NULL\&quot;\n  EQUIPMENT_ASSETS ||--o{ MAINTENANCE_LOGS : \&quot;undergoes CASCADE\&quot;\n  SERVICE_TICKETS ||--o{ TICKET_ASSET_ALLOCATIONS : \&quot;allocates\&quot;\n  EQUIPMENT_ASSETS ||--o{ TICKET_ASSET_ALLOCATIONS : \&quot;allocated in\&quot;\n  SERVICE_TICKETS ||--o{ TICKET_COLLABORATORS : \&quot;collaborates on\&quot;\n  USERS ||--o{ TICKET_COLLABORATORS : \&quot;assists as agent\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="249">
